{
  "name": "dsh-usage-kit",
  "version": "0.2.0",
  "private": true,
  "description": "DSH plugin: an actionable context coach above the composer and a per-turn usage receipt under every completed turn.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "cordis-plugin",
    "context",
    "usage",
    "cost",
    "web-ui"
  ],
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node scripts/pricing-spec.mjs && node scripts/client-spec.mjs && node scripts/client-smoke.mjs && node scripts/theme-tokens.mjs && node scripts/visual-tokens.mjs",
    "test:host": "node --experimental-strip-types scripts/host-smoke.mjs",
    "verify": "node scripts/verify-deployed.mjs",
    "install:profile": "node scripts/install.mjs",
    "publish": "node scripts/publish.mjs"
  }
}
